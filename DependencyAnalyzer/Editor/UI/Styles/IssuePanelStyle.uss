.dependency-issue-panel {
    height: 148px;
    min-height: 36px;
    border-top-width: 1px;
    border-top-color: #343941;
    background-color: #20242a;
}

.dependency-issue-resize-handle {
    height: 3px;
    min-height: 3px;
    background-color: #20242a;
    cursor: resize-vertical;
}

.dependency-issue-resize-handle:hover {
    background-color: #4b5866;
}

.dependency-issue-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    background-color: #252a30;
}

.dependency-issue-title {
    flex-grow: 0;
    color: #e6ebf2;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-warning-status {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
}

.dependency-issue-warning-icon {
    width: 16px;
    height: 16px;
    margin-right: 5px;
    flex-shrink: 0;
}

.dependency-issue-warning-count {
    min-width: 20px;
    color: #cfd5dd;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.dependency-issue-header Button {
    min-width: 24px;
    width: 24px;
    height: 22px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-issue-toggle-button {
    min-width: 24px;
    width: 24px;
    height: 22px;
}

.dependency-issue-list {
    flex-grow: 1;
}

.dependency-issue-empty {
    height: 38px;
    padding-left: 10px;
    color: #9ca6b3;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-group {
    border-bottom-width: 1px;
    border-bottom-color: #30363e;
}

.dependency-issue-group-row,
.dependency-issue-object-group-row {
    min-height: 31px;
    flex-direction: row;
    align-items: center;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.dependency-issue-group-row {
    padding-left: 8px;
    background-color: #252a30;
}

.dependency-issue-object-group-row {
    padding-left: 24px;
    background-color: #22272d;
}

.dependency-issue-group-row:hover,
.dependency-issue-object-group-row:hover,
.dependency-issue-location-row:hover {
    background-color: #303943;
}

.dependency-issue-group-chevron,
.dependency-issue-object-group-chevron {
    width: 24px;
    height: 22px;
    margin-right: 3px;
    flex-shrink: 0;
}

.dependency-issue-group-warning-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.dependency-issue-object-group-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    flex-shrink: 0;
}

.dependency-issue-group-title,
.dependency-issue-object-group-title {
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 1;
    color: #eef2f7;
    font-size: 11px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-issue-group-title {
    -unity-font-style: bold;
}

.dependency-issue-group-count,
.dependency-issue-object-group-count {
    min-width: 0;
    margin-left: 6px;
    flex-shrink: 0;
    color: #b8c1cc;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-location-list {
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: #20242a;
}

.dependency-issue-location-list--issue-child .dependency-issue-location-row {
    padding-left: 32px;
}

.dependency-issue-location-list--object-child .dependency-issue-location-row {
    padding-left: 48px;
}

.dependency-issue-location-row {
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-left: 0;
    margin-right: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-issue-location-row--disabled {
    opacity: 0.62;
}

.dependency-issue-location-accent {
    width: 6px;
    height: 22px;
    min-width: 6px;
    margin-right: 5px;
    flex-shrink: 0;
}

.dependency-issue-location-type {
    min-width: 58px;
    max-width: 120px;
    margin-right: 10px;
    flex-shrink: 0;
    color: #d8dee7;
    font-size: 11px;
    -unity-font-style: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.dependency-issue-location-source-name {
    max-width: 220px;
    min-width: 0;
    margin-right: 12px;
    flex-shrink: 1;
    color: #eef2f7;
    font-size: 11px;
    -unity-font-style: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.dependency-issue-location-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: #aeb8c4;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

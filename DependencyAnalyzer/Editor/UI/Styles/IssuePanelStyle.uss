.dependency-issue-panel {
    height: 148px;
    min-height: 36px;
    border-top-width: 1px;
    border-top-color: #343941;
    background-color: #20242a;
}

.dependency-issue-resize-handle {
    height: 3px;
    min-height: 3px;
    background-color: #20242a;
    cursor: resize-vertical;
}

.dependency-issue-resize-handle:hover {
    background-color: #4b5866;
}

.dependency-issue-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    background-color: #252a30;
}

.dependency-issue-title {
    flex-grow: 0;
    color: #e6ebf2;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-total-count {
    min-width: 22px;
    margin-left: 7px;
    color: #cfd5dd;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.dependency-issue-filter-controls {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    flex-grow: 1;
}

.dependency-issue-filter-button {
    min-width: 40px;
    width: 40px;
    height: 21px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #535860;
    border-right-color: #202328;
    border-bottom-color: #191c20;
    border-left-color: #535860;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: #3a3e44;
}

.dependency-issue-filter-button:hover {
    background-color: #454a51;
}

.dependency-issue-filter-button--off {
    opacity: 0.42;
}

.dependency-issue-filter-icon {
    width: 17px;
    height: 17px;
    margin-left: -1px;
    margin-right: 4px;
    flex-shrink: 0;
}

.dependency-issue-filter-count {
    color: #cfd3d8;
    font-size: 13px;
    margin-left: -1px;
    -unity-text-align: middle-left;
}

.dependency-issue-header Button {
    min-width: 24px;
    width: 24px;
    height: 22px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-issue-header .dependency-issue-filter-button {
    min-width: 40px;
    width: 40px;
    height: 21px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-right: 0;
    padding-left: 2px;
    padding-right: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #535860;
    border-right-color: #202328;
    border-bottom-color: #191c20;
    border-left-color: #535860;
    background-color: #3a3e44;
}

.dependency-issue-toggle-button {
    min-width: 24px;
    width: 24px;
    height: 22px;
}

.dependency-issue-list {
    flex-grow: 1;
}

.dependency-issue-empty {
    height: 38px;
    padding-left: 10px;
    color: #9ca6b3;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-group {
    border-bottom-width: 1px;
    border-bottom-color: #30363e;
}

.dependency-issue-group-row {
    min-height: 31px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: #252a30;
}

.dependency-issue-group-row:hover {
    background-color: #303943;
}

.dependency-issue-group-chevron {
    width: 18px;
    height: 18px;
    margin-right: 3px;
    flex-shrink: 0;
}

.dependency-issue-group-type-icon {
    width: 18px;
    height: 18px;
    margin-right: 5px;
    flex-shrink: 0;
}

.dependency-issue-group-severity-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.dependency-issue-group-title {
    min-width: 0;
    flex-grow: 1;
    color: #eef2f7;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-issue-group-count {
    min-width: 28px;
    margin-left: 8px;
    color: #b8c1cc;
    font-size: 11px;
    -unity-text-align: middle-right;
}

.dependency-issue-location-list {
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: #20242a;
}

.dependency-issue-location-branch {
    min-height: 20px;
    padding-right: 10px;
    color: #8f9aa7;
    font-size: 10px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-issue-occurrence-row {
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-left: 0;
    margin-right: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 3px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-issue-occurrence-row:hover {
    background-color: #303943;
}

.dependency-issue-row--info {
}

.dependency-issue-row--warning {
}

.dependency-issue-row--error {
}

.dependency-issue-row--disabled {
    opacity: 0.62;
}

.dependency-issue-severity-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.dependency-issue-node-icon {
    width: 18px;
    height: 18px;
    margin-right: 7px;
    flex-shrink: 0;
}

.dependency-issue-occurrence-label {
    flex-grow: 1;
    min-width: 0;
    color: #dce2ea;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

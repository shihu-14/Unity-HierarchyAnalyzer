.dependency-node {
    width: 260px;
    height: 92px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
    overflow: visible;
}

.dependency-node:hover {
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

.dependency-node-flash-ring {
    position: absolute;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(143, 161, 179, 0.1);
}

.dependency-node-search-ring {
    position: absolute;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(143, 161, 179, 0.08);
}

.dependency-node-ghost {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 240, 106, 0.72);
    border-right-color: rgba(255, 184, 79, 0.5);
    border-bottom-color: rgba(255, 184, 79, 0.36);
    border-left-color: rgba(255, 240, 106, 0.72);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(80, 86, 94, 0.5);
}

.dependency-node-accent {
    position: absolute;
    left: 1px;
    top: 1px;
    bottom: 1px;
    width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 0;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 0;
    background-color: #8fa1b3;
}

.dependency-node-stack-shadow {
    position: absolute;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
}

.dependency-node-stack-shadow--right {
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 6px;
}

.dependency-node-stack-shadow--bottom {
    border-top-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.dependency-node-stack-shadow--corner {
    border-top-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 6px;
}

.dependency-node--prefab .dependency-node-stack-shadow {
    border-top-color: #3370a5;
    border-right-color: #3370a5;
    border-bottom-color: #3370a5;
    border-left-color: #3370a5;
    background-color: #132b4a;
}

.dependency-node--material .dependency-node-stack-shadow {
    border-top-color: #a95c32;
    border-right-color: #a95c32;
    border-bottom-color: #a95c32;
    border-left-color: #a95c32;
    background-color: #452515;
}

.dependency-node--texture .dependency-node-stack-shadow {
    border-top-color: #20839b;
    border-right-color: #20839b;
    border-bottom-color: #20839b;
    border-left-color: #20839b;
    background-color: #153842;
}

.dependency-node--audio .dependency-node-stack-shadow {
    border-top-color: #755281;
    border-right-color: #755281;
    border-bottom-color: #755281;
    border-left-color: #755281;
    background-color: #382b44;
}

.dependency-node--animator .dependency-node-stack-shadow {
    border-top-color: #a8324d;
    border-right-color: #a8324d;
    border-bottom-color: #a8324d;
    border-left-color: #a8324d;
    background-color: #451b28;
}

.dependency-node--mesh .dependency-node-stack-shadow {
    border-top-color: #7d8793;
    border-right-color: #7d8793;
    border-bottom-color: #7d8793;
    border-left-color: #7d8793;
    background-color: #30343a;
}

.dependency-node--scriptable-object .dependency-node-stack-shadow {
    border-top-color: #6851b8;
    border-right-color: #6851b8;
    border-bottom-color: #6851b8;
    border-left-color: #6851b8;
    background-color: #2c2645;
}

.dependency-node--scene .dependency-node-stack-shadow {
    border-top-color: #4e7081;
    border-right-color: #4e7081;
    border-bottom-color: #4e7081;
    border-left-color: #4e7081;
    background-color: #293842;
}

.dependency-node--object .dependency-node-stack-shadow {
    border-top-color: #4e6e81;
    border-right-color: #4e6e81;
    border-bottom-color: #4e6e81;
    border-left-color: #4e6e81;
    background-color: #26343d;
}

.dependency-node--component .dependency-node-stack-shadow {
    border-top-color: #228766;
    border-right-color: #228766;
    border-bottom-color: #228766;
    border-left-color: #228766;
    background-color: #173b32;
}

.dependency-node--csharp .dependency-node-stack-shadow {
    border-top-color: #478954;
    border-right-color: #478954;
    border-bottom-color: #478954;
    border-left-color: #478954;
    background-color: #243a2a;
}

.dependency-node--camera .dependency-node-stack-shadow {
    border-top-color: #6557aa;
    border-right-color: #6557aa;
    border-bottom-color: #6557aa;
    border-left-color: #6557aa;
    background-color: #2d2845;
}

.dependency-node--canvas .dependency-node-stack-shadow {
    border-top-color: #915383;
    border-right-color: #915383;
    border-bottom-color: #915383;
    border-left-color: #915383;
    background-color: #402138;
}

.dependency-node--light .dependency-node-stack-shadow {
    border-top-color: #8e8145;
    border-right-color: #8e8145;
    border-bottom-color: #8e8145;
    border-left-color: #8e8145;
    background-color: #423b23;
}

.dependency-node--issue-warning .dependency-node-stack-shadow {
    border-top-color: #9b702f;
    border-right-color: #9b702f;
    border-bottom-color: #9b702f;
    border-left-color: #9b702f;
    background-color: #43301c;
}

.dependency-node--issue-error .dependency-node-stack-shadow {
    border-top-color: #982f37;
    border-right-color: #982f37;
    border-bottom-color: #982f37;
    border-left-color: #982f37;
    background-color: #432020;
}

.dependency-node--issue-info .dependency-node-stack-shadow {
    border-top-color: #4281a8;
    border-right-color: #4281a8;
    border-bottom-color: #4281a8;
    border-left-color: #4281a8;
    background-color: #213043;
}

.dependency-node--default .dependency-node-stack-shadow {
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    background-color: #2c3239;
}

.dependency-node--impact-medium {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.dependency-node--impact-high {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
}

.dependency-node-header {
    height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 8px;
    padding-top: 7px;
}

.dependency-node-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}

.dependency-node-issue-marker {
    width: 20px;
    height: 20px;
    margin-right: 5px;
    flex-shrink: 0;
}

.dependency-node-title-stack {
    flex-grow: 1;
    min-width: 0;
}

.dependency-node-name {
    color: #f2f4f7;
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-type {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-path {
    height: 32px;
    margin-left: 14px;
    margin-right: 8px;
    color: #87929f;
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
}

.dependency-node-badges {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.dependency-node-control-stack {
    flex-direction: column;
    align-items: center;
}

.dependency-node-toggle {
    min-width: 18px;
    width: 18px;
    height: 18px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(230, 238, 247, 0.16);
    color: #ffffff;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle:hover {
    background-color: rgba(230, 238, 247, 0.28);
}

.dependency-node-menu-toggle {
    min-width: 18px;
    width: 18px;
    height: 18px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(208, 170, 85, 0.22);
    color: #ffd66f;
    font-size: 7.875px;
    -unity-text-align: middle-center;
}

.dependency-node-menu-toggle:hover,
.dependency-node-menu-toggle--expanded {
    background-color: rgba(208, 170, 85, 0.42);
    color: #ffffff;
}

.dependency-node-parent-jump {
    position: absolute;
    left: -10px;
    top: 34px;
    width: 20px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(18, 22, 27, 0.9);
    color: #dce9f7;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.dependency-node-parent-jump:hover {
    background-color: rgba(114, 168, 192, 0.9);
    color: #10161b;
}

.dependency-node-warning {
    width: 18px;
    height: 18px;
    margin-left: 4px;
}

.dependency-node--prefab .dependency-node-accent {
    background-color: #52a7ff;
}

.dependency-node--prefab {
    background-color: #132b4a;
    border-top-color: #3370a5;
    border-right-color: #3370a5;
    border-bottom-color: #3370a5;
    border-left-color: #3370a5;
}

.dependency-node--material .dependency-node-accent {
    background-color: #ff8a3d;
}

.dependency-node--material {
    background-color: #452515;
    border-top-color: #a95c32;
    border-right-color: #a95c32;
    border-bottom-color: #a95c32;
    border-left-color: #a95c32;
}

.dependency-node--texture .dependency-node-accent {

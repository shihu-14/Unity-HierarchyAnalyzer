.dependency-window {
    flex-grow: 1;
    background-color: #1d2024;
}

.dependency-toolbar {
    height: 34px;
    flex-direction: row;
    align-items: center;
    overflow: visible;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #343941;
    background-color: #252a30;
}

.dependency-toolbar Button {
    min-width: 72px;
    height: 22px;
    margin-right: 6px;
}

.dependency-load-progress-label {
    width: 88px;
    height: 22px;
    margin-right: 28px;
    color: #d7dae0;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-status-label {
    color: #d7dae0;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.dependency-search-control {
    min-width: 280px;
    max-width: 280px;
    width: 280px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
    margin-right: 10px;
    margin-top: 1px;
    margin-bottom: 3px;
    padding-left: 18px;
    padding-right: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #252a30;
    overflow: visible;
}

.dependency-search-field-wrap {
    position: relative;
    min-width: 86px;
    height: 20px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 7px;
    overflow: visible;
}

.dependency-search-field-wrap TextField {
    width: 100%;
    height: 20px;
    margin-right: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.dependency-search-icon {
    position: absolute;
    left: 6px;
    top: 5px;
    width: 14px;
    height: 14px;
}

.dependency-search-field-wrap TextField:focus {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.dependency-search-field-wrap TextField Label {
    width: 0;
    min-width: 0;
    color: #c7d0dc;
}

.dependency-search-field-wrap TextField TextInput {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0.25px;
    border-right-width: 0.25px;
    border-bottom-width: 0.25px;
    border-left-width: 0.25px;
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: #efe7e7;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    font-size: 14px;
}

.dependency-search-field-wrap TextField TextInput:focus {
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-search-field-wrap .unity-base-text-field__input,
.dependency-search-field-wrap .unity-text-field__input {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0.25px;
    border-right-width: 0.25px;
    border-bottom-width: 0.25px;
    border-left-width: 0.25px;
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: #efe7e7;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    font-size: 14px;
}

.dependency-search-field-wrap .unity-base-text-field__input:focus,
.dependency-search-field-wrap .unity-text-field__input:focus {
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-search-control Button {
    min-width: 18px;
    width: 18px;
    height: 20px;
    margin-right: 0;
    margin-top: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.dependency-search-arrow-button {
    margin-top: 4px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.dependency-search-suggestion-list {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    max-height: 520px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #46515e;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #46515e;
    background-color: #1f242b;
    overflow: visible;
}

.dependency-search-suggestion-row {
    min-height: 38px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.dependency-search-suggestion-row:hover {
    background-color: #303943;
}

.dependency-search-suggestion-title {
    color: #eef2f7;
    font-size: 11px;
    white-space: normal;
    overflow: visible;
}

.dependency-search-suggestion-detail {
    color: #aeb8c4;
    font-size: 10px;
    white-space: normal;
    overflow: visible;
}

.dependency-search-count {
    width: 48px;
    height: 20px;
    margin-top: 2px;
    color: #d7dae0;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: visible;
}

.dependency-search-divider {
    width: 0.5px;
    height: 20px;
    margin-left: 5px;
    margin-right: 7px;
    margin-top: 2px;
    background-color: #b8b8b8;
}

.dependency-zoom-step-control {
    width: 196px;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 10px;
}

.dependency-zoom-scale-label {
    width: 78px;
    margin-right: 4px;
    color: #c7d0dc;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-zoom-step-control Slider {
    width: 108px;
}

.dependency-graph-container {
    flex-grow: 1;
    position: relative;
}

.dependency-issue-panel {
    height: 148px;
    min-height: 36px;
    border-top-width: 1px;
    border-top-color: #343941;
    background-color: #20242a;
}

.dependency-issue-resize-handle {
    height: 3px;
    min-height: 3px;
    background-color: #20242a;
    cursor: resize-vertical;
}

.dependency-issue-resize-handle:hover {
    background-color: #4b5866;
}

.dependency-issue-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    background-color: #252a30;
}

.dependency-issue-title {
    flex-grow: 0;
    color: #e6ebf2;
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-left;
}

.dependency-issue-filter-controls {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    flex-grow: 1;
}

.dependency-issue-filter-button {
    min-width: 40px;
    width: 40px;
    height: 21px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #535860;
    border-right-color: #202328;
    border-bottom-color: #191c20;
    border-left-color: #535860;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: #3a3e44;
}

.dependency-issue-filter-button:hover {
    background-color: #454a51;
}

.dependency-issue-filter-button--off {
    opacity: 0.42;
}

.dependency-issue-filter-icon {
    width: 17px;
    height: 17px;
    margin-left: -1px;
    margin-right: 4px;
    flex-shrink: 0;
}

.dependency-issue-filter-count {
    color: #cfd3d8;
    font-size: 13px;
    margin-left: -1px;
    -unity-text-align: middle-left;
}

.dependency-issue-header Button {
    min-width: 24px;
    width: 24px;
    height: 22px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-issue-header .dependency-issue-filter-button {
    min-width: 40px;
    width: 40px;
    height: 21px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-right: 0;
    padding-left: 2px;
    padding-right: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #535860;
    border-right-color: #202328;
    border-bottom-color: #191c20;
    border-left-color: #535860;
    background-color: #3a3e44;
}

.dependency-issue-toggle-button {
    min-width: 24px;
    width: 24px;
    height: 22px;
}

.dependency-issue-list {
    flex-grow: 1;
}

.dependency-issue-empty {
    height: 38px;
    padding-left: 10px;
    color: #9ca6b3;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-section-header {
    min-height: 25px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #30363e;
    background-color: #252a30;
}

.dependency-issue-section-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.dependency-issue-section-label {
    color: #dce2ea;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-row {
    min-height: 42px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-left-width: 5.4px;
    border-bottom-width: 1px;
    border-bottom-color: #30363e;
}

.dependency-issue-row:hover {
    background-color: #303943;
}

.dependency-issue-row--info {
}

.dependency-issue-row--warning {
}

.dependency-issue-row--error {
}

.dependency-issue-row--disabled {
    opacity: 0.62;
}

.dependency-issue-severity-icon {
    width: 17px;
    height: 17px;
    margin-right: 7px;
    flex-shrink: 0;
}

.dependency-issue-node-icon {
    width: 18px;
    height: 18px;
    margin-right: 7px;
    flex-shrink: 0;
}

.dependency-issue-text {
    flex-grow: 1;
    min-width: 0;
}

.dependency-issue-main {
    color: #f2f4f7;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-issue-detail {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-graph-view {
    flex-grow: 1;
    background-color: #191c20;
}

.dependency-graph-content {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-edge-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-animation-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-node-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-empty-state {
    position: absolute;
    left: 18px;
    top: 18px;
    color: #9ca6b3;
    font-size: 12px;
}

.dependency-minimap {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 184px;
    height: 124px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #4c5966;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #4c5966;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(21, 25, 30, 0.86);
}

.dependency-node {
    width: 260px;
    height: 92px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
    overflow: visible;
}

.dependency-node:hover {
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

.dependency-node-flash-ring {
    position: absolute;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(143, 161, 179, 0.1);
}

.dependency-node-search-ring {
    position: absolute;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(143, 161, 179, 0.08);
}

.dependency-node-ghost {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 240, 106, 0.72);
    border-right-color: rgba(255, 184, 79, 0.5);
    border-bottom-color: rgba(255, 184, 79, 0.36);
    border-left-color: rgba(255, 240, 106, 0.72);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(80, 86, 94, 0.5);
}

.dependency-node-accent {
    position: absolute;
    left: 1px;
    top: 1px;
    bottom: 1px;
    width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 0;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 0;
    background-color: #8fa1b3;
}

.dependency-node-stack-shadow {
    position: absolute;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
}

.dependency-node-stack-shadow--right {
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 6px;
}

.dependency-node-stack-shadow--bottom {
    border-top-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.dependency-node-stack-shadow--corner {
    border-top-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 6px;
}

.dependency-node--prefab .dependency-node-stack-shadow {
    border-top-color: #3370a5;
    border-right-color: #3370a5;
    border-bottom-color: #3370a5;
    border-left-color: #3370a5;
    background-color: #132b4a;
}

.dependency-node--material .dependency-node-stack-shadow {
    border-top-color: #a95c32;
    border-right-color: #a95c32;
    border-bottom-color: #a95c32;
    border-left-color: #a95c32;
    background-color: #452515;
}

.dependency-node--texture .dependency-node-stack-shadow {
    border-top-color: #20839b;
    border-right-color: #20839b;
    border-bottom-color: #20839b;
    border-left-color: #20839b;
    background-color: #153842;
}

.dependency-node--audio .dependency-node-stack-shadow {
    border-top-color: #755281;
    border-right-color: #755281;
    border-bottom-color: #755281;
    border-left-color: #755281;
    background-color: #382b44;
}

.dependency-node--animator .dependency-node-stack-shadow {
    border-top-color: #a8324d;
    border-right-color: #a8324d;
    border-bottom-color: #a8324d;
    border-left-color: #a8324d;
    background-color: #451b28;
}

.dependency-node--mesh .dependency-node-stack-shadow {
    border-top-color: #7d8793;
    border-right-color: #7d8793;
    border-bottom-color: #7d8793;
    border-left-color: #7d8793;
    background-color: #30343a;
}

.dependency-node--scriptable-object .dependency-node-stack-shadow {
    border-top-color: #6851b8;
    border-right-color: #6851b8;
    border-bottom-color: #6851b8;
    border-left-color: #6851b8;
    background-color: #2c2645;
}

.dependency-node--scene .dependency-node-stack-shadow {
    border-top-color: #4e7081;
    border-right-color: #4e7081;
    border-bottom-color: #4e7081;
    border-left-color: #4e7081;
    background-color: #293842;
}

.dependency-node--object .dependency-node-stack-shadow {
    border-top-color: #4e6e81;
    border-right-color: #4e6e81;
    border-bottom-color: #4e6e81;
    border-left-color: #4e6e81;
    background-color: #26343d;
}

.dependency-node--component .dependency-node-stack-shadow {
    border-top-color: #228766;
    border-right-color: #228766;
    border-bottom-color: #228766;
    border-left-color: #228766;
    background-color: #173b32;
}

.dependency-node--csharp .dependency-node-stack-shadow {
    border-top-color: #478954;
    border-right-color: #478954;
    border-bottom-color: #478954;
    border-left-color: #478954;
    background-color: #243a2a;
}

.dependency-node--camera .dependency-node-stack-shadow {
    border-top-color: #6557aa;
    border-right-color: #6557aa;
    border-bottom-color: #6557aa;
    border-left-color: #6557aa;
    background-color: #2d2845;
}

.dependency-node--canvas .dependency-node-stack-shadow {
    border-top-color: #915383;
    border-right-color: #915383;
    border-bottom-color: #915383;
    border-left-color: #915383;
    background-color: #402138;
}

.dependency-node--light .dependency-node-stack-shadow {
    border-top-color: #8e8145;
    border-right-color: #8e8145;
    border-bottom-color: #8e8145;
    border-left-color: #8e8145;
    background-color: #423b23;
}

.dependency-node--missing .dependency-node-stack-shadow {
    border-top-color: #8d4648;
    border-right-color: #8d4648;
    border-bottom-color: #8d4648;
    border-left-color: #8d4648;
    background-color: #3a282b;
}

.dependency-node--issue-warning .dependency-node-stack-shadow {
    border-top-color: #9b702f;
    border-right-color: #9b702f;
    border-bottom-color: #9b702f;
    border-left-color: #9b702f;
    background-color: #43301c;
}

.dependency-node--issue-error .dependency-node-stack-shadow {
    border-top-color: #982f37;
    border-right-color: #982f37;
    border-bottom-color: #982f37;
    border-left-color: #982f37;
    background-color: #432020;
}

.dependency-node--issue-info .dependency-node-stack-shadow {
    border-top-color: #4281a8;
    border-right-color: #4281a8;
    border-bottom-color: #4281a8;
    border-left-color: #4281a8;
    background-color: #213043;
}

.dependency-node--default .dependency-node-stack-shadow {
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    background-color: #2c3239;
}

.dependency-node--impact-medium {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.dependency-node--impact-high {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
}

.dependency-node-header {
    height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 8px;
    padding-top: 7px;
}

.dependency-node-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}

.dependency-node-issue-marker {
    width: 20px;
    height: 20px;
    margin-right: 5px;
    flex-shrink: 0;
}

.dependency-node-title-stack {
    flex-grow: 1;
    min-width: 0;
}

.dependency-node-name {
    color: #f2f4f7;
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-type {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-path {
    height: 32px;
    margin-left: 14px;
    margin-right: 8px;
    color: #87929f;
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
}

.dependency-node-badges {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.dependency-node-control-stack {
    flex-direction: column;
    align-items: center;
}

.dependency-node-badge {
    min-width: 20px;
    height: 17px;
    margin-left: 4px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(10, 13, 17, 0.62);
    color: #ffffff;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle {
    min-width: 18px;
    width: 18px;
    height: 18px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(230, 238, 247, 0.16);
    color: #ffffff;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle:hover {
    background-color: rgba(230, 238, 247, 0.28);
}

.dependency-node-menu-toggle {
    min-width: 18px;
    width: 18px;
    height: 18px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(208, 170, 85, 0.22);
    color: #ffd66f;
    font-size: 7.875px;
    -unity-text-align: middle-center;
}

.dependency-node-menu-toggle:hover,
.dependency-node-menu-toggle--expanded {
    background-color: rgba(208, 170, 85, 0.42);
    color: #ffffff;
}

.dependency-node-parent-jump {
    position: absolute;
    left: -10px;
    top: 34px;
    width: 20px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(18, 22, 27, 0.9);
    color: #dce9f7;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.dependency-node-parent-jump:hover {
    background-color: rgba(114, 168, 192, 0.9);
    color: #10161b;
}

.dependency-node-warning {
    width: 18px;
    height: 18px;
    margin-left: 4px;
}


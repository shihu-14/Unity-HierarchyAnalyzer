.dependency-window {
    flex-grow: 1;
    background-color: #1d2024;
}

.dependency-toolbar {
    height: 34px;
    flex-direction: row;
    align-items: center;
    overflow: visible;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #343941;
    background-color: #252a30;
}

.dependency-toolbar Button {
    min-width: 72px;
    height: 22px;
    margin-right: 6px;
}

.dependency-load-progress-label {
    width: 88px;
    height: 22px;
    margin-right: 28px;
    color: #d7dae0;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-status-label {
    color: #d7dae0;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.dependency-search-control {
    min-width: 213px;
    max-width: 347px;
    width: 347px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
    margin-right: 10px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 18px;
    padding-right: 12px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #46515e;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #46515e;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #252a30;
    overflow: visible;
}

.dependency-search-field-wrap {
    position: relative;
    min-width: 86px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 7px;
    overflow: visible;
}

.dependency-search-field-wrap TextField {
    width: 100%;
    height: 26px;
    margin-right: 0;
}

.dependency-search-field-wrap TextField Label {
    width: 0;
    min-width: 0;
    color: #c7d0dc;
}

.dependency-search-field-wrap TextField TextInput {
    height: 26px;
    background-color: rgba(0, 0, 0, 0);
    color: #efe7e7;
    -unity-font-style: bold;
    font-size: 14px;
}

.dependency-search-field-wrap .unity-base-text-field__input,
.dependency-search-field-wrap .unity-text-field__input {
    height: 26px;
    background-color: rgba(0, 0, 0, 0);
    color: #efe7e7;
    -unity-font-style: bold;
    font-size: 14px;
}

.dependency-search-control Button {
    min-width: 20px;
    width: 20px;
    height: 22px;
    margin-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.dependency-search-arrow-button {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.dependency-search-suggestion-list {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    max-height: 178px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #46515e;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #46515e;
    background-color: #1f242b;
}

.dependency-search-suggestion-row {
    min-height: 34px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.dependency-search-suggestion-row:hover {
    background-color: #303943;
}

.dependency-search-suggestion-title {
    color: #eef2f7;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-search-suggestion-detail {
    color: #aeb8c4;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-search-count {
    width: 36px;
    height: 22px;
    color: #d7dae0;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-search-divider {
    width: 1px;
    height: 22px;
    margin-left: 5px;
    margin-right: 7px;
    background-color: #000000;
}

.dependency-zoom-step-control {
    width: 250px;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 10px;
}

.dependency-zoom-scale-label {
    width: 78px;
    margin-right: 4px;
    color: #c7d0dc;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-zoom-step-control Slider {
    width: 162px;
}

.dependency-graph-container {
    flex-grow: 1;
    position: relative;
}

.dependency-issue-panel {
    height: 148px;
    min-height: 36px;
    border-top-width: 1px;
    border-top-color: #343941;
    background-color: #20242a;
}

.dependency-issue-resize-handle {
    height: 3px;
    min-height: 3px;
    background-color: #20242a;
    cursor: resize-vertical;
}

.dependency-issue-resize-handle:hover {
    background-color: #4b5866;
}

.dependency-issue-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    background-color: #252a30;
}

.dependency-issue-title {
    flex-grow: 1;
    color: #e6ebf2;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-header Button {
    min-width: 30px;
    width: 30px;
    height: 24px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-issue-toggle-button {
    min-width: 30px;
    width: 30px;
    height: 24px;
}

.dependency-issue-list {
    flex-grow: 1;
}

.dependency-issue-empty {
    height: 38px;
    padding-left: 10px;
    color: #9ca6b3;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-row {
    min-height: 42px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: #30363e;
}

.dependency-issue-row:hover {
    background-color: #303943;
}

.dependency-issue-row--info {
    border-left-width: 3px;
    border-left-color: #72a8c0;
}

.dependency-issue-row--warning {
    border-left-width: 3px;
    border-left-color: #d9c766;
}

.dependency-issue-row--error {
    border-left-width: 3px;
    border-left-color: #df6464;
}

.dependency-issue-row--disabled {
    opacity: 0.62;
}

.dependency-issue-main {
    color: #f2f4f7;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-issue-detail {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-graph-view {
    flex-grow: 1;
    background-color: #191c20;
}

.dependency-graph-content {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-edge-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-animation-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-node-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-empty-state {
    position: absolute;
    left: 18px;
    top: 18px;
    color: #9ca6b3;
    font-size: 12px;
}

.dependency-minimap {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 184px;
    height: 124px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #4c5966;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #4c5966;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(21, 25, 30, 0.86);
}

.dependency-node {
    width: 260px;
    height: 92px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #4a515b;
    border-right-color: #313740;
    border-bottom-color: #252a31;
    border-left-color: #4a515b;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
    overflow: visible;
}

.dependency-node:hover {
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

.dependency-node--search-match {
    border-top-color: rgba(143, 161, 179, 0.72);
    border-right-color: rgba(143, 161, 179, 0.52);
    border-bottom-color: rgba(143, 161, 179, 0.38);
    border-left-color: rgba(143, 161, 179, 0.72);
}

.dependency-node--search-current {
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

.dependency-node-flash-ring {
    position: absolute;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(143, 161, 179, 0.1);
}

.dependency-node-ghost {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 240, 106, 0.72);
    border-right-color: rgba(255, 184, 79, 0.5);
    border-bottom-color: rgba(255, 184, 79, 0.36);
    border-left-color: rgba(255, 240, 106, 0.72);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(80, 86, 94, 0.5);
}

.dependency-node-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: #8fa1b3;
}

.dependency-node-stack-shadow {
    position: absolute;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(120, 152, 184, 0.42);
    border-right-color: rgba(120, 152, 184, 0.22);
    border-bottom-color: rgba(120, 152, 184, 0.18);
    border-left-color: rgba(120, 152, 184, 0.42);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(60, 72, 84, 0.42);
}

.dependency-node-stack-shadow--right {
    border-left-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

.dependency-node-stack-shadow--bottom {
    border-top-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

.dependency-node--prefab .dependency-node-stack-shadow {
    border-top-color: rgba(82, 167, 255, 0.52);
    border-right-color: rgba(82, 167, 255, 0.26);
    border-bottom-color: rgba(82, 167, 255, 0.2);
    border-left-color: rgba(82, 167, 255, 0.52);
    background-color: rgba(19, 43, 74, 0.5);
}

.dependency-node--material .dependency-node-stack-shadow {
    border-top-color: rgba(208, 170, 85, 0.52);
    border-right-color: rgba(208, 170, 85, 0.26);
    border-bottom-color: rgba(208, 170, 85, 0.2);
    border-left-color: rgba(208, 170, 85, 0.52);
    background-color: rgba(63, 52, 33, 0.5);
}

.dependency-node--texture .dependency-node-stack-shadow {
    border-top-color: rgba(94, 182, 132, 0.52);
    border-right-color: rgba(94, 182, 132, 0.26);
    border-bottom-color: rgba(94, 182, 132, 0.2);
    border-left-color: rgba(94, 182, 132, 0.52);
    background-color: rgba(36, 59, 49, 0.5);
}

.dependency-node--audio .dependency-node-stack-shadow {
    border-top-color: rgba(177, 120, 198, 0.52);
    border-right-color: rgba(177, 120, 198, 0.26);
    border-bottom-color: rgba(177, 120, 198, 0.2);
    border-left-color: rgba(177, 120, 198, 0.52);
    background-color: rgba(56, 43, 68, 0.5);
}

.dependency-node--mesh .dependency-node-stack-shadow {
    border-top-color: rgba(166, 155, 142, 0.52);
    border-right-color: rgba(166, 155, 142, 0.26);
    border-bottom-color: rgba(166, 155, 142, 0.2);
    border-left-color: rgba(166, 155, 142, 0.52);
    background-color: rgba(54, 50, 47, 0.5);
}

.dependency-node--scriptable-object .dependency-node-stack-shadow {
    border-top-color: rgba(196, 130, 103, 0.52);
    border-right-color: rgba(196, 130, 103, 0.26);
    border-bottom-color: rgba(196, 130, 103, 0.2);
    border-left-color: rgba(196, 130, 103, 0.52);
    background-color: rgba(61, 45, 41, 0.5);
}

.dependency-node--scene .dependency-node-stack-shadow,
.dependency-node--object .dependency-node-stack-shadow {
    border-top-color: rgba(118, 168, 197, 0.52);
    border-right-color: rgba(118, 168, 197, 0.26);
    border-bottom-color: rgba(118, 168, 197, 0.2);
    border-left-color: rgba(118, 168, 197, 0.52);
    background-color: rgba(38, 52, 61, 0.5);
}

.dependency-node--component .dependency-node-stack-shadow {
    border-top-color: rgba(158, 211, 132, 0.52);
    border-right-color: rgba(158, 211, 132, 0.26);
    border-bottom-color: rgba(158, 211, 132, 0.2);
    border-left-color: rgba(158, 211, 132, 0.52);
    background-color: rgba(41, 58, 39, 0.5);
}

.dependency-node--csharp .dependency-node-stack-shadow {
    border-top-color: rgba(105, 183, 121, 0.52);
    border-right-color: rgba(105, 183, 121, 0.26);
    border-bottom-color: rgba(105, 183, 121, 0.2);
    border-left-color: rgba(105, 183, 121, 0.52);
    background-color: rgba(36, 58, 42, 0.5);
}

.dependency-node--camera .dependency-node-stack-shadow {
    border-top-color: rgba(107, 184, 214, 0.52);
    border-right-color: rgba(107, 184, 214, 0.26);
    border-bottom-color: rgba(107, 184, 214, 0.2);
    border-left-color: rgba(107, 184, 214, 0.52);
    background-color: rgba(35, 57, 68, 0.5);
}

.dependency-node--canvas .dependency-node-stack-shadow {
    border-top-color: rgba(226, 104, 173, 0.52);
    border-right-color: rgba(226, 104, 173, 0.26);
    border-bottom-color: rgba(226, 104, 173, 0.2);
    border-left-color: rgba(226, 104, 173, 0.52);
    background-color: rgba(64, 33, 56, 0.5);
}

.dependency-node--light .dependency-node-stack-shadow {
    border-top-color: rgba(217, 199, 102, 0.52);
    border-right-color: rgba(217, 199, 102, 0.26);
    border-bottom-color: rgba(217, 199, 102, 0.2);
    border-left-color: rgba(217, 199, 102, 0.52);
    background-color: rgba(66, 59, 35, 0.5);
}

.dependency-node--missing .dependency-node-stack-shadow {
    border-top-color: rgba(223, 100, 100, 0.52);
    border-right-color: rgba(223, 100, 100, 0.26);
    border-bottom-color: rgba(223, 100, 100, 0.2);
    border-left-color: rgba(223, 100, 100, 0.52);
    background-color: rgba(58, 40, 43, 0.5);
}

.dependency-node--issue-warning .dependency-node-stack-shadow {
    border-top-color: rgba(242, 176, 70, 0.52);
    border-right-color: rgba(242, 176, 70, 0.26);
    border-bottom-color: rgba(242, 176, 70, 0.2);
    border-left-color: rgba(242, 176, 70, 0.52);
    background-color: rgba(67, 48, 28, 0.5);
}

.dependency-node--issue-error .dependency-node-stack-shadow {
    border-top-color: rgba(236, 78, 78, 0.52);
    border-right-color: rgba(236, 78, 78, 0.26);
    border-bottom-color: rgba(236, 78, 78, 0.2);
    border-left-color: rgba(236, 78, 78, 0.52);
    background-color: rgba(67, 32, 32, 0.5);
}

.dependency-node--issue-info .dependency-node-stack-shadow {
    border-top-color: rgba(99, 171, 242, 0.52);
    border-right-color: rgba(99, 171, 242, 0.26);
    border-bottom-color: rgba(99, 171, 242, 0.2);
    border-left-color: rgba(99, 171, 242, 0.52);
    background-color: rgba(33, 48, 67, 0.5);
}

.dependency-node--default .dependency-node-stack-shadow {
    border-top-color: rgba(143, 161, 179, 0.52);
    border-right-color: rgba(143, 161, 179, 0.26);
    border-bottom-color: rgba(143, 161, 179, 0.2);
    border-left-color: rgba(143, 161, 179, 0.52);
    background-color: rgba(44, 50, 57, 0.5);
}

.dependency-node--impact-medium {
    border-top-width: 2px;
    border-left-width: 2px;
}

.dependency-node--impact-high {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #d6e6f4;
    border-right-color: #88aeca;
    border-bottom-color: #5f829c;
    border-left-color: #d6e6f4;
}

.dependency-node-header {
    height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 8px;
    padding-top: 7px;
}

.dependency-node-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}

.dependency-node-title-stack {
    flex-grow: 1;
    min-width: 0;
}

.dependency-node-name {
    color: #f2f4f7;
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-type {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-path {
    height: 32px;
    margin-left: 14px;
    margin-right: 8px;
    color: #87929f;
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
}

.dependency-node-badges {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.dependency-node-badge {
    min-width: 20px;
    height: 17px;
    margin-left: 4px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(10, 13, 17, 0.62);
    color: #ffffff;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle {
    min-width: 20px;
    width: 20px;
    height: 20px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(230, 238, 247, 0.16);
    color: #ffffff;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle:hover {
    background-color: rgba(230, 238, 247, 0.28);
}

.dependency-node-menu-toggle {
    min-width: 20px;
    width: 20px;
    height: 20px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(208, 170, 85, 0.22);
    color: #ffd66f;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.dependency-node-menu-toggle:hover,
.dependency-node-menu-toggle--expanded {
    background-color: rgba(208, 170, 85, 0.42);
    color: #ffffff;
}

.dependency-node-parent-jump {
    position: absolute;
    left: -10px;
    top: 34px;
    width: 20px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(18, 22, 27, 0.9);
    color: #dce9f7;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.dependency-node-parent-jump:hover {
    background-color: rgba(114, 168, 192, 0.9);
    color: #10161b;
}

.dependency-node-warning {

.dependency-window {
    flex-grow: 1;
    background-color: #1d2024;
}

.dependency-toolbar {
    height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #343941;
    background-color: #252a30;
}

.dependency-toolbar Button {
    min-width: 72px;
    height: 22px;
    margin-right: 6px;
}

.dependency-status-label {
    color: #d7dae0;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.dependency-zoom-step-control {
    width: 224px;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 10px;
}

.dependency-zoom-step-control Slider {
    width: 174px;
}

.dependency-zoom-step-value {
    width: 38px;
    margin-left: 6px;
    color: #d7dae0;
    font-size: 10px;
    -unity-text-align: middle-left;
}

.dependency-graph-container {
    flex-grow: 1;
    position: relative;
}

.dependency-graph-view {
    flex-grow: 1;
    background-color: #191c20;
}

.dependency-graph-content {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-edge-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-animation-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-node-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-empty-state {
    position: absolute;
    left: 18px;
    top: 18px;
    color: #9ca6b3;
    font-size: 12px;
}

.dependency-minimap {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 184px;
    height: 124px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #4c5966;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #4c5966;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(21, 25, 30, 0.86);
}

.dependency-node {
    width: 260px;
    height: 92px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #4a515b;
    border-right-color: #313740;
    border-bottom-color: #252a31;
    border-left-color: #4a515b;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
    overflow: visible;
}

.dependency-node:hover {
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

.dependency-node-flash-ring {
    position: absolute;
    left: -5px;
    top: -5px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: #fff6a8;
    border-right-color: #ffe36a;
    border-bottom-color: #ffb84f;
    border-left-color: #fff6a8;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(255, 240, 106, 0);
}

.dependency-node-ghost {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 240, 106, 0.72);
    border-right-color: rgba(255, 184, 79, 0.5);
    border-bottom-color: rgba(255, 184, 79, 0.36);
    border-left-color: rgba(255, 240, 106, 0.72);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(80, 86, 94, 0.5);
}

.dependency-node-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: #8fa1b3;
}

.dependency-node-stack-shadow {
    position: absolute;
    width: 260px;
    height: 92px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(120, 152, 184, 0.42);
    border-right-color: rgba(120, 152, 184, 0.22);
    border-bottom-color: rgba(120, 152, 184, 0.18);
    border-left-color: rgba(120, 152, 184, 0.42);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(60, 72, 84, 0.42);
}

.dependency-node-stack-shadow--back {
    left: 12px;
    top: 12px;
}

.dependency-node-stack-shadow--middle {
    left: 6px;
    top: 6px;
}

.dependency-node--prefab .dependency-node-stack-shadow {
    border-top-color: rgba(82, 167, 255, 0.52);
    border-right-color: rgba(82, 167, 255, 0.26);
    border-bottom-color: rgba(82, 167, 255, 0.2);
    border-left-color: rgba(82, 167, 255, 0.52);
    background-color: rgba(19, 43, 74, 0.5);
}

.dependency-node--material .dependency-node-stack-shadow {
    border-top-color: rgba(208, 170, 85, 0.52);
    border-right-color: rgba(208, 170, 85, 0.26);
    border-bottom-color: rgba(208, 170, 85, 0.2);
    border-left-color: rgba(208, 170, 85, 0.52);
    background-color: rgba(63, 52, 33, 0.5);
}

.dependency-node--texture .dependency-node-stack-shadow {
    border-top-color: rgba(94, 182, 132, 0.52);
    border-right-color: rgba(94, 182, 132, 0.26);
    border-bottom-color: rgba(94, 182, 132, 0.2);
    border-left-color: rgba(94, 182, 132, 0.52);
    background-color: rgba(36, 59, 49, 0.5);
}

.dependency-node--audio .dependency-node-stack-shadow {
    border-top-color: rgba(177, 120, 198, 0.52);
    border-right-color: rgba(177, 120, 198, 0.26);
    border-bottom-color: rgba(177, 120, 198, 0.2);
    border-left-color: rgba(177, 120, 198, 0.52);
    background-color: rgba(56, 43, 68, 0.5);
}

.dependency-node--mesh .dependency-node-stack-shadow {
    border-top-color: rgba(166, 155, 142, 0.52);
    border-right-color: rgba(166, 155, 142, 0.26);
    border-bottom-color: rgba(166, 155, 142, 0.2);
    border-left-color: rgba(166, 155, 142, 0.52);
    background-color: rgba(54, 50, 47, 0.5);
}

.dependency-node--scriptable-object .dependency-node-stack-shadow {
    border-top-color: rgba(196, 130, 103, 0.52);
    border-right-color: rgba(196, 130, 103, 0.26);
    border-bottom-color: rgba(196, 130, 103, 0.2);
    border-left-color: rgba(196, 130, 103, 0.52);
    background-color: rgba(61, 45, 41, 0.5);
}

.dependency-node--scene .dependency-node-stack-shadow,
.dependency-node--object .dependency-node-stack-shadow {
    border-top-color: rgba(118, 168, 197, 0.52);
    border-right-color: rgba(118, 168, 197, 0.26);
    border-bottom-color: rgba(118, 168, 197, 0.2);
    border-left-color: rgba(118, 168, 197, 0.52);
    background-color: rgba(38, 52, 61, 0.5);
}

.dependency-node--component .dependency-node-stack-shadow {
    border-top-color: rgba(158, 211, 132, 0.52);
    border-right-color: rgba(158, 211, 132, 0.26);
    border-bottom-color: rgba(158, 211, 132, 0.2);
    border-left-color: rgba(158, 211, 132, 0.52);
    background-color: rgba(41, 58, 39, 0.5);
}

.dependency-node--csharp .dependency-node-stack-shadow {
    border-top-color: rgba(105, 183, 121, 0.52);
    border-right-color: rgba(105, 183, 121, 0.26);
    border-bottom-color: rgba(105, 183, 121, 0.2);
    border-left-color: rgba(105, 183, 121, 0.52);
    background-color: rgba(36, 58, 42, 0.5);
}

.dependency-node--camera .dependency-node-stack-shadow {
    border-top-color: rgba(107, 184, 214, 0.52);
    border-right-color: rgba(107, 184, 214, 0.26);
    border-bottom-color: rgba(107, 184, 214, 0.2);
    border-left-color: rgba(107, 184, 214, 0.52);
    background-color: rgba(35, 57, 68, 0.5);
}

.dependency-node--canvas .dependency-node-stack-shadow {
    border-top-color: rgba(226, 104, 173, 0.52);
    border-right-color: rgba(226, 104, 173, 0.26);
    border-bottom-color: rgba(226, 104, 173, 0.2);
    border-left-color: rgba(226, 104, 173, 0.52);
    background-color: rgba(64, 33, 56, 0.5);
}

.dependency-node--light .dependency-node-stack-shadow {
    border-top-color: rgba(217, 199, 102, 0.52);
    border-right-color: rgba(217, 199, 102, 0.26);
    border-bottom-color: rgba(217, 199, 102, 0.2);
    border-left-color: rgba(217, 199, 102, 0.52);
    background-color: rgba(66, 59, 35, 0.5);
}

.dependency-node--missing .dependency-node-stack-shadow {
    border-top-color: rgba(223, 100, 100, 0.52);
    border-right-color: rgba(223, 100, 100, 0.26);
    border-bottom-color: rgba(223, 100, 100, 0.2);
    border-left-color: rgba(223, 100, 100, 0.52);
    background-color: rgba(58, 40, 43, 0.5);
}

.dependency-node--default .dependency-node-stack-shadow {
    border-top-color: rgba(143, 161, 179, 0.52);
    border-right-color: rgba(143, 161, 179, 0.26);
    border-bottom-color: rgba(143, 161, 179, 0.2);
    border-left-color: rgba(143, 161, 179, 0.52);
    background-color: rgba(44, 50, 57, 0.5);
}

.dependency-node--impact-medium {
    border-top-width: 2px;
    border-left-width: 2px;
}

.dependency-node--impact-high {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #d6e6f4;
    border-right-color: #88aeca;
    border-bottom-color: #5f829c;
    border-left-color: #d6e6f4;
}

.dependency-node-header {
    height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 8px;
    padding-top: 7px;
}

.dependency-node-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}

.dependency-node-title-stack {
    flex-grow: 1;
    min-width: 0;
}

.dependency-node-name {
    color: #f2f4f7;
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-type {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-path {
    height: 32px;
    margin-left: 14px;
    margin-right: 8px;
    color: #87929f;
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
}

.dependency-node-badges {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.dependency-node-badge {
    min-width: 20px;
    height: 17px;
    margin-left: 4px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(10, 13, 17, 0.62);
    color: #ffffff;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle {
    min-width: 22px;
    height: 18px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(230, 238, 247, 0.16);
    color: #ffffff;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle:hover {
    background-color: rgba(230, 238, 247, 0.28);
}

.dependency-node-menu-toggle {
    min-width: 26px;
    height: 18px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(208, 170, 85, 0.22);
    color: #ffd66f;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.dependency-node-menu-toggle:hover,
.dependency-node-menu-toggle--expanded {
    background-color: rgba(208, 170, 85, 0.42);
    color: #ffffff;
}

.dependency-node-parent-jump {
    position: absolute;
    left: -10px;
    top: 34px;
    width: 20px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(18, 22, 27, 0.9);
    color: #dce9f7;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.dependency-node-parent-jump:hover {
    background-color: rgba(114, 168, 192, 0.9);
    color: #10161b;
}

.dependency-node-warning {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

.dependency-node--prefab .dependency-node-accent {
    background-color: #52a7ff;
}

.dependency-node--prefab {
    background-color: #132b4a;
    border-top-color: #3b79b6;
    border-left-color: #3b79b6;
}

.dependency-node--material .dependency-node-accent {
    background-color: #d0aa55;
}

.dependency-node--material {
    background-color: #3f3421;
}

.dependency-node--texture .dependency-node-accent {
    background-color: #5eb684;
}

.dependency-node--texture {
    background-color: #243b31;
}

.dependency-node--audio .dependency-node-accent {
    background-color: #b178c6;
}

.dependency-node--audio {
    background-color: #382b44;
}

.dependency-node--mesh .dependency-node-accent {
    background-color: #a69b8e;
}

.dependency-node--mesh {
    background-color: #36322f;
}

.dependency-node--scriptable-object .dependency-node-accent {
    background-color: #c48267;
}

.dependency-node--scriptable-object {
    background-color: #3d2d29;
}

.dependency-node--scene .dependency-node-accent {
    background-color: #72a8c0;
}

.dependency-node--scene {
    background-color: #293842;
}

.dependency-node--object .dependency-node-accent {
    background-color: #76a8c5;
}

.dependency-node--object {
    background-color: #26343d;
}

.dependency-node--component .dependency-node-accent {
    background-color: #9ed384;
}

.dependency-node--component {
    background-color: #293a27;
}

.dependency-node--csharp .dependency-node-accent {
    background-color: #69b779;
}

.dependency-node--csharp {
    background-color: #243a2a;
}

.dependency-node--camera .dependency-node-accent {
    background-color: #6bb8d6;
}

.dependency-node--camera {
    background-color: #233944;
}

.dependency-node--canvas .dependency-node-accent {
    background-color: #e268ad;
}

.dependency-node--canvas {
    background-color: #402138;
}

.dependency-node--light .dependency-node-accent {
    background-color: #d9c766;
}

.dependency-node--light {
    background-color: #423b23;
}

.dependency-node--missing .dependency-node-accent {
    background-color: #df6464;
}

.dependency-node--missing {
    background-color: #3a282b;
}

.dependency-node--default .dependency-node-accent {
    background-color: #8fa1b3;
}

.dependency-node--prefab:hover {
    border-top-color: #52a7ff;
    border-right-color: #52a7ff;
    border-bottom-color: #52a7ff;
    border-left-color: #52a7ff;
}

.dependency-node--material:hover {
    border-top-color: #d0aa55;
    border-right-color: #d0aa55;
    border-bottom-color: #d0aa55;
    border-left-color: #d0aa55;
}

.dependency-node--texture:hover {
    border-top-color: #5eb684;
    border-right-color: #5eb684;
    border-bottom-color: #5eb684;
    border-left-color: #5eb684;
}

.dependency-node--audio:hover {
    border-top-color: #b178c6;
    border-right-color: #b178c6;
    border-bottom-color: #b178c6;
    border-left-color: #b178c6;
}

.dependency-node--mesh:hover {
    border-top-color: #a69b8e;
    border-right-color: #a69b8e;
    border-bottom-color: #a69b8e;
    border-left-color: #a69b8e;
}

.dependency-node--scriptable-object:hover {
    border-top-color: #c48267;
    border-right-color: #c48267;
    border-bottom-color: #c48267;
    border-left-color: #c48267;
}

.dependency-node--object:hover,
.dependency-node--scene:hover {
    border-top-color: #76a8c5;
    border-right-color: #76a8c5;
    border-bottom-color: #76a8c5;
    border-left-color: #76a8c5;
}

.dependency-node--component:hover {
    border-top-color: #9ed384;
    border-right-color: #9ed384;
    border-bottom-color: #9ed384;
    border-left-color: #9ed384;
}

.dependency-node--csharp:hover {
    border-top-color: #69b779;
    border-right-color: #69b779;
    border-bottom-color: #69b779;
    border-left-color: #69b779;
}

.dependency-node--camera:hover {
    border-top-color: #6bb8d6;
    border-right-color: #6bb8d6;
    border-bottom-color: #6bb8d6;
    border-left-color: #6bb8d6;
}

.dependency-node--canvas:hover {
    border-top-color: #e268ad;
    border-right-color: #e268ad;
    border-bottom-color: #e268ad;
    border-left-color: #e268ad;
}

.dependency-node--light:hover {
    border-top-color: #d9c766;
    border-right-color: #d9c766;
    border-bottom-color: #d9c766;
    border-left-color: #d9c766;
}

.dependency-node--missing:hover {
    border-top-color: #df6464;
    border-right-color: #df6464;
    border-bottom-color: #df6464;
    border-left-color: #df6464;
}

.dependency-node--default:hover {
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

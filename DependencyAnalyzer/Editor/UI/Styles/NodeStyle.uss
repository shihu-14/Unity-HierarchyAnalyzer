.dependency-window {
    flex-grow: 1;
    background-color: #1d2024;
}

.dependency-toolbar {
    height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #343941;
    background-color: #252a30;
}

.dependency-toolbar Button {
    min-width: 72px;
    height: 22px;
    margin-right: 6px;
}

.dependency-toolbar IntegerField {
    width: 118px;
    margin-left: 8px;
    margin-right: 12px;
}

.dependency-status-label {
    color: #d7dae0;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.dependency-zoom-step-control {
    width: 224px;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 10px;
}

.dependency-zoom-step-control Slider {
    width: 174px;
}

.dependency-zoom-step-value {
    width: 38px;
    margin-left: 6px;
    color: #d7dae0;
    font-size: 10px;
    -unity-text-align: middle-left;
}

.dependency-graph-container {
    flex-grow: 1;
    position: relative;
}

.dependency-graph-view {
    flex-grow: 1;
    background-color: #191c20;
}

.dependency-graph-content {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-edge-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-node-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-empty-state {
    position: absolute;
    left: 18px;
    top: 18px;
    color: #9ca6b3;
    font-size: 12px;
}

.dependency-minimap {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 184px;
    height: 124px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #4c5966;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #4c5966;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(21, 25, 30, 0.86);
}

.dependency-node {
    width: 260px;
    height: 92px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #4a515b;
    border-right-color: #313740;
    border-bottom-color: #252a31;
    border-left-color: #4a515b;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
    overflow: visible;
}

.dependency-node:hover {
    border-top-color: #7fa6cf;
    border-right-color: #7fa6cf;
    border-bottom-color: #7fa6cf;
    border-left-color: #7fa6cf;
}

.dependency-node--focused {
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: #ffffff;
    border-right-color: #a9d4ff;
    border-bottom-color: #7fb7ef;
    border-left-color: #ffffff;
}

.dependency-node-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: #8fa1b3;
}

.dependency-node-stack-shadow {
    position: absolute;
    width: 260px;
    height: 92px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(120, 152, 184, 0.42);
    border-right-color: rgba(120, 152, 184, 0.22);
    border-bottom-color: rgba(120, 152, 184, 0.18);
    border-left-color: rgba(120, 152, 184, 0.42);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(60, 72, 84, 0.42);
}

.dependency-node-stack-shadow--back {
    left: 12px;
    top: 12px;
}

.dependency-node-stack-shadow--middle {
    left: 6px;
    top: 6px;
}

.dependency-node--expandable {
    border-top-color: #87add2;
    border-left-color: #87add2;
}

.dependency-node--impact-medium {
    border-top-width: 2px;
    border-left-width: 2px;
}

.dependency-node--impact-high {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #d6e6f4;
    border-right-color: #88aeca;
    border-bottom-color: #5f829c;
    border-left-color: #d6e6f4;
}

.dependency-node-header {
    height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 8px;
    padding-top: 7px;
}

.dependency-node-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}

.dependency-node-title-stack {
    flex-grow: 1;
    min-width: 0;
}

.dependency-node-name {
    color: #f2f4f7;
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-type {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-path {
    height: 32px;
    margin-left: 14px;
    margin-right: 8px;
    color: #87929f;
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
}

.dependency-node-badges {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.dependency-node-badge {
    min-width: 20px;
    height: 17px;
    margin-left: 4px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(10, 13, 17, 0.62);
    color: #ffffff;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.dependency-node-warning {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

.dependency-node--prefab .dependency-node-accent {
    background-color: #52a7ff;
}

.dependency-node--prefab {
    background-color: #132b4a;
    border-top-color: #3b79b6;
    border-left-color: #3b79b6;
}

.dependency-node--material .dependency-node-accent {
    background-color: #d0aa55;
}

.dependency-node--material {
    background-color: #3f3421;
}

.dependency-node--texture .dependency-node-accent {
    background-color: #5eb684;
}

.dependency-node--texture {
    background-color: #243b31;
}

.dependency-node--audio .dependency-node-accent {
    background-color: #b178c6;
}

.dependency-node--audio {
    background-color: #382b44;
}

.dependency-node--mesh .dependency-node-accent {
    background-color: #a69b8e;
}

.dependency-node--mesh {
    background-color: #36322f;
}

.dependency-node--scriptable-object .dependency-node-accent {
    background-color: #c48267;
}

.dependency-node--scriptable-object {
    background-color: #3d2d29;
}

.dependency-node--scene .dependency-node-accent {
    background-color: #72a8c0;
}

.dependency-node--scene {
    background-color: #293842;
}

.dependency-node--object .dependency-node-accent {
    background-color: #76a8c5;
}

.dependency-node--object {
    background-color: #26343d;
}

.dependency-node--component .dependency-node-accent {
    background-color: #9ed384;
}

.dependency-node--component {
    background-color: #293a27;
}

.dependency-node--csharp .dependency-node-accent {
    background-color: #69b779;
}

.dependency-node--csharp {
    background-color: #243a2a;
}

.dependency-node--camera .dependency-node-accent {
    background-color: #6bb8d6;
}

.dependency-node--camera {
    background-color: #233944;
}

.dependency-node--light .dependency-node-accent {
    background-color: #d9c766;
}

.dependency-node--light {
    background-color: #423b23;
}

.dependency-node--missing .dependency-node-accent {
    background-color: #df6464;
}

.dependency-node--missing {
    background-color: #3a282b;
}

.dependency-node--default .dependency-node-accent {
    background-color: #8fa1b3;
}

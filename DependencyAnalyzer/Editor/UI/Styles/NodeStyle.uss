.dependency-window {
    flex-grow: 1;
    background-color: #1d2024;
}

.dependency-toolbar {
    height: 34px;
    flex-direction: row;
    align-items: center;
    overflow: visible;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #343941;
    background-color: #252a30;
}

.dependency-toolbar Button {
    min-width: 72px;
    height: 22px;
    margin-right: 6px;
}

.dependency-load-progress-label {
    width: 88px;
    height: 22px;
    margin-right: 28px;
    color: #d7dae0;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-status-label {
    color: #d7dae0;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.dependency-search-control {
    min-width: 213px;
    max-width: 347px;
    width: 347px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
    margin-right: 10px;
    margin-top: 6px;
    margin-bottom: -2px;
    padding-left: 18px;
    padding-right: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #252a30;
    overflow: visible;
}

.dependency-search-field-wrap {
    position: relative;
    min-width: 86px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 7px;
    overflow: visible;
}

.dependency-search-field-wrap TextField {
    width: 100%;
    height: 24px;
    margin-right: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.dependency-search-field-wrap TextField:focus {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.dependency-search-field-wrap TextField Label {
    width: 0;
    min-width: 0;
    color: #c7d0dc;
}

.dependency-search-field-wrap TextField TextInput {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0.25px;
    border-right-width: 0.25px;
    border-bottom-width: 0.25px;
    border-left-width: 0.25px;
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: #efe7e7;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    font-size: 14px;
}

.dependency-search-field-wrap TextField TextInput:focus {
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-search-field-wrap .unity-base-text-field__input,
.dependency-search-field-wrap .unity-text-field__input {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0.25px;
    border-right-width: 0.25px;
    border-bottom-width: 0.25px;
    border-left-width: 0.25px;
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: #efe7e7;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    font-size: 14px;
}

.dependency-search-field-wrap .unity-base-text-field__input:focus,
.dependency-search-field-wrap .unity-text-field__input:focus {
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-search-control Button {
    min-width: 18px;
    width: 18px;
    height: 20px;
    margin-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.dependency-search-arrow-button {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.dependency-search-suggestion-list {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    max-height: 178px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #46515e;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #46515e;
    background-color: #1f242b;
}

.dependency-search-suggestion-row {
    min-height: 34px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.dependency-search-suggestion-row:hover {
    background-color: #303943;
}

.dependency-search-suggestion-title {
    color: #eef2f7;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-search-suggestion-detail {
    color: #aeb8c4;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-search-count {
    width: 36px;
    height: 22px;
    color: #d7dae0;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-search-divider {
    width: 0.5px;
    height: 22px;
    margin-left: 5px;
    margin-right: 7px;
    background-color: #b8b8b8;
}

.dependency-zoom-step-control {
    width: 250px;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 10px;
}

.dependency-zoom-scale-label {
    width: 78px;
    margin-right: 4px;
    color: #c7d0dc;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-zoom-step-control Slider {
    width: 162px;
}

.dependency-graph-container {
    flex-grow: 1;
    position: relative;
}

.dependency-issue-panel {
    height: 148px;
    min-height: 36px;
    border-top-width: 1px;
    border-top-color: #343941;
    background-color: #20242a;
}

.dependency-issue-resize-handle {
    height: 3px;
    min-height: 3px;
    background-color: #20242a;
    cursor: resize-vertical;
}

.dependency-issue-resize-handle:hover {
    background-color: #4b5866;
}

.dependency-issue-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    background-color: #252a30;
}

.dependency-issue-title {
    flex-grow: 1;
    color: #e6ebf2;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-header Button {
    min-width: 24px;
    width: 24px;
    height: 22px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-issue-toggle-button {
    min-width: 24px;
    width: 24px;
    height: 22px;
}

.dependency-issue-list {
    flex-grow: 1;
}

.dependency-issue-empty {
    height: 38px;
    padding-left: 10px;
    color: #9ca6b3;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-issue-row {
    min-height: 42px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: #30363e;
}

.dependency-issue-row:hover {
    background-color: #303943;
}

.dependency-issue-row--info {
    border-left-width: 3px;
    border-left-color: #72a8c0;
}

.dependency-issue-row--warning {
    border-left-width: 3px;
    border-left-color: #d9c766;
}

.dependency-issue-row--error {
    border-left-width: 3px;
    border-left-color: #df6464;
}

.dependency-issue-row--disabled {
    opacity: 0.62;
}

.dependency-issue-main {
    color: #f2f4f7;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-issue-detail {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-graph-view {
    flex-grow: 1;
    background-color: #191c20;
}

.dependency-graph-content {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-edge-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-animation-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-node-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.dependency-empty-state {
    position: absolute;
    left: 18px;
    top: 18px;
    color: #9ca6b3;
    font-size: 12px;
}

.dependency-minimap {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 184px;
    height: 124px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #4c5966;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #4c5966;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(21, 25, 30, 0.86);
}

.dependency-node {
    width: 260px;
    height: 92px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
    overflow: visible;
}

.dependency-node:hover {
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

.dependency-node--search-match {
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

.dependency-node--search-current {
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
}

.dependency-node-flash-ring {
    position: absolute;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(143, 161, 179, 0.1);
}

.dependency-node-search-ring {
    position: absolute;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: #8fa1b3;
    border-right-color: #8fa1b3;
    border-bottom-color: #8fa1b3;
    border-left-color: #8fa1b3;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(143, 161, 179, 0.08);
}

.dependency-node-ghost {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 240, 106, 0.72);
    border-right-color: rgba(255, 184, 79, 0.5);
    border-bottom-color: rgba(255, 184, 79, 0.36);
    border-left-color: rgba(255, 240, 106, 0.72);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(80, 86, 94, 0.5);
}

.dependency-node-accent {
    position: absolute;
    left: 1px;
    top: 1px;
    bottom: 1px;
    width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 0;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 0;
    background-color: #8fa1b3;
}

.dependency-node-stack-shadow {
    position: absolute;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #2c3239;
}

.dependency-node--prefab .dependency-node-stack-shadow {
    border-top-color: #3370a5;
    border-right-color: #3370a5;
    border-bottom-color: #3370a5;
    border-left-color: #3370a5;
    background-color: #132b4a;
}

.dependency-node--material .dependency-node-stack-shadow {
    border-top-color: #887344;
    border-right-color: #887344;
    border-bottom-color: #887344;
    border-left-color: #887344;
    background-color: #3f3421;
}

.dependency-node--texture .dependency-node-stack-shadow {
    border-top-color: #416f5b;
    border-right-color: #416f5b;
    border-bottom-color: #416f5b;
    border-left-color: #416f5b;
    background-color: #243b31;
}

.dependency-node--audio .dependency-node-stack-shadow {
    border-top-color: #755281;
    border-right-color: #755281;
    border-bottom-color: #755281;
    border-left-color: #755281;
    background-color: #382b44;
}

.dependency-node--animator .dependency-node-stack-shadow {
    border-top-color: #9c6248;
    border-right-color: #9c6248;
    border-bottom-color: #9c6248;
    border-left-color: #9c6248;
    background-color: #3f2b24;
}

.dependency-node--mesh .dependency-node-stack-shadow {
    border-top-color: #6e675f;
    border-right-color: #6e675f;
    border-bottom-color: #6e675f;
    border-left-color: #6e675f;
    background-color: #36322f;
}

.dependency-node--scriptable-object .dependency-node-stack-shadow {
    border-top-color: #806055;
    border-right-color: #806055;
    border-bottom-color: #806055;
    border-left-color: #806055;
    background-color: #3d2d29;
}

.dependency-node--scene .dependency-node-stack-shadow {
    border-top-color: #4e7081;
    border-right-color: #4e7081;
    border-bottom-color: #4e7081;
    border-left-color: #4e7081;
    background-color: #293842;
}

.dependency-node--object .dependency-node-stack-shadow {
    border-top-color: #4e6e81;
    border-right-color: #4e6e81;
    border-bottom-color: #4e6e81;
    border-left-color: #4e6e81;
    background-color: #26343d;
}

.dependency-node--component .dependency-node-stack-shadow {
    border-top-color: #64975a;
    border-right-color: #64975a;
    border-bottom-color: #64975a;
    border-left-color: #64975a;
    background-color: #293a27;
}

.dependency-node--csharp .dependency-node-stack-shadow {
    border-top-color: #478954;
    border-right-color: #478954;
    border-bottom-color: #478954;
    border-left-color: #478954;
    background-color: #243a2a;
}

.dependency-node--camera .dependency-node-stack-shadow {
    border-top-color: #47788d;
    border-right-color: #47788d;
    border-bottom-color: #47788d;
    border-left-color: #47788d;
    background-color: #233944;
}

.dependency-node--canvas .dependency-node-stack-shadow {
    border-top-color: #915383;
    border-right-color: #915383;
    border-bottom-color: #915383;
    border-left-color: #915383;
    background-color: #402138;
}

.dependency-node--light .dependency-node-stack-shadow {
    border-top-color: #8e8145;
    border-right-color: #8e8145;
    border-bottom-color: #8e8145;
    border-left-color: #8e8145;
    background-color: #423b23;
}

.dependency-node--missing .dependency-node-stack-shadow {
    border-top-color: #8d4648;
    border-right-color: #8d4648;
    border-bottom-color: #8d4648;
    border-left-color: #8d4648;
    background-color: #3a282b;
}

.dependency-node--issue-warning .dependency-node-stack-shadow {
    border-top-color: #9b702f;
    border-right-color: #9b702f;
    border-bottom-color: #9b702f;
    border-left-color: #9b702f;
    background-color: #43301c;
}

.dependency-node--issue-error .dependency-node-stack-shadow {
    border-top-color: #982f37;
    border-right-color: #982f37;
    border-bottom-color: #982f37;
    border-left-color: #982f37;
    background-color: #432020;
}

.dependency-node--issue-info .dependency-node-stack-shadow {
    border-top-color: #4281a8;
    border-right-color: #4281a8;
    border-bottom-color: #4281a8;
    border-left-color: #4281a8;
    background-color: #213043;
}

.dependency-node--default .dependency-node-stack-shadow {
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
    background-color: #2c3239;
}

.dependency-node--impact-medium {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.dependency-node--impact-high {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #5e6a76;
    border-right-color: #5e6a76;
    border-bottom-color: #5e6a76;
    border-left-color: #5e6a76;
}

.dependency-node-header {
    height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 8px;
    padding-top: 7px;
}

.dependency-node-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}

.dependency-node-issue-marker {
    width: 20px;
    height: 20px;
    margin-right: 5px;
    flex-shrink: 0;
}

.dependency-node-title-stack {
    flex-grow: 1;
    min-width: 0;
}

.dependency-node-name {
    color: #f2f4f7;
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-type {
    color: #aeb8c4;
    font-size: 10px;
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dependency-node-path {
    height: 32px;
    margin-left: 14px;
    margin-right: 8px;
    color: #87929f;
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
}

.dependency-node-badges {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.dependency-node-control-stack {
    flex-direction: column;
    align-items: center;
}

.dependency-node-badge {
    min-width: 20px;
    height: 17px;
    margin-left: 4px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    background-color: rgba(10, 13, 17, 0.62);
    color: #ffffff;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle {
    min-width: 16px;
    width: 16px;
    height: 16px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(230, 238, 247, 0.16);
    color: #ffffff;
    font-size: 30px;
    -unity-text-align: middle-center;
}

.dependency-node-toggle:hover {
    background-color: rgba(230, 238, 247, 0.28);
}

.dependency-node-menu-toggle {
    min-width: 16px;
    width: 16px;
    height: 16px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(208, 170, 85, 0.22);
    color: #ffd66f;
    font-size: 7px;
    -unity-text-align: middle-center;
}

.dependency-node-menu-toggle:hover,
.dependency-node-menu-toggle--expanded {
    background-color: rgba(208, 170, 85, 0.42);
    color: #ffffff;
}

.dependency-node-parent-jump {
    position: absolute;
    left: -10px;
    top: 34px;
    width: 20px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(18, 22, 27, 0.9);
    color: #dce9f7;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.dependency-node-parent-jump:hover {
    background-color: rgba(114, 168, 192, 0.9);
    color: #10161b;
}

.dependency-node-warning {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}


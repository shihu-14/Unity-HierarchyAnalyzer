.dependency-edge {
    --edge-color: #9da8b6;
}

.dependency-edge--staticasset {
    --edge-color: #b8c7d9;
}

.dependency-edge--hierarchy {
    --edge-color: #7fb4dc;
}

.dependency-edge--prefabinstance {
    --edge-color: #d6a87b;
}

.dependency-edge--serializedproperty {
    --edge-color: #8ec7a2;
}

.dependency-edge-label {
    position: absolute;
    max-width: 168px;
    padding-left: 5px;
    padding-right: 5px;
    height: 18px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgba(31, 32, 35, 0.92);
    color: #eef1f4;
    font-size: 10px;
    -unity-text-align: middle-center;
}

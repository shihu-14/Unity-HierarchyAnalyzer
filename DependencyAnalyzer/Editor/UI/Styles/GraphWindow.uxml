<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="dependency-window-root" class="dependency-window">
        <ui:VisualElement name="dependency-toolbar" class="dependency-toolbar">
            <ui:Button name="load-button" text="Load" />
            <ui:Label name="load-progress-label" text="" class="dependency-load-progress-label" />
            <ui:VisualElement name="depth-control" class="dependency-depth-control">
                <ui:Label name="depth-label" text="Depth" class="dependency-depth-label" />
                <ui:SliderInt name="depth-slider" low-value="0" high-value="6" value="2" page-size="1" show-input-field="false" />
                <ui:Label name="depth-value-label" text="2" class="dependency-depth-value" />
            </ui:VisualElement>
            <ui:VisualElement name="search-control" class="dependency-search-control">
                <ui:VisualElement name="search-field-wrap" class="dependency-search-field-wrap">
                    <ui:TextField name="search-field" />
                    <ui:VisualElement name="search-suggestion-list" class="dependency-search-suggestion-list" />
                </ui:VisualElement>
                <ui:Label name="search-count-label" text="0 / 0" class="dependency-search-count" />
                <ui:VisualElement name="search-divider" class="dependency-search-divider" />
                <ui:Button name="search-previous-button" text="" class="dependency-search-arrow-button" />
                <ui:Button name="search-next-button" text="" class="dependency-search-arrow-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="graph-container" class="dependency-graph-container" />
        <ui:VisualElement name="issue-panel" class="dependency-issue-panel">
            <ui:VisualElement name="issue-resize-handle" class="dependency-issue-resize-handle" />
            <ui:VisualElement name="issue-panel-header" class="dependency-issue-header">
                <ui:Label name="issue-title-label" text="Issues" class="dependency-issue-title" />
                <ui:VisualElement name="issue-warning-status" class="dependency-issue-warning-status">
                    <ui:Image name="issue-warning-icon" class="dependency-issue-warning-icon" />
                    <ui:Label name="issue-warning-count-label" text="0" class="dependency-issue-warning-count" />
                </ui:VisualElement>
                <ui:Button name="issue-toggle-button" text="" />
            </ui:VisualElement>
            <ui:ScrollView name="issue-list" class="dependency-issue-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

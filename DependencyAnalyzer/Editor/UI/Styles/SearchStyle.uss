.dependency-search-control {
    min-width: 280px;
    max-width: 280px;
    width: 280px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
    margin-right: 10px;
    margin-top: 1px;
    margin-bottom: 3px;
    padding-left: 18px;
    padding-right: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #252a30;
    overflow: visible;
}

.dependency-search-field-wrap {
    position: relative;
    min-width: 86px;
    height: 20px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 7px;
    overflow: visible;
}

.dependency-search-field-wrap TextField {
    width: 100%;
    height: 20px;
    margin-right: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.dependency-search-icon {
    position: absolute;
    left: 6px;
    top: 5px;
    width: 14px;
    height: 14px;
}

.dependency-search-field-wrap TextField:focus {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.dependency-search-field-wrap TextField Label {
    width: 0;
    min-width: 0;
    color: #c7d0dc;
}

.dependency-search-field-wrap TextField TextInput {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0.25px;
    border-right-width: 0.25px;
    border-bottom-width: 0.25px;
    border-left-width: 0.25px;
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: #efe7e7;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    font-size: 14px;
}

.dependency-search-field-wrap TextField TextInput:focus {
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-search-field-wrap .unity-base-text-field__input,
.dependency-search-field-wrap .unity-text-field__input {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0.25px;
    border-right-width: 0.25px;
    border-bottom-width: 0.25px;
    border-left-width: 0.25px;
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: #efe7e7;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    font-size: 14px;
}

.dependency-search-field-wrap .unity-base-text-field__input:focus,
.dependency-search-field-wrap .unity-text-field__input:focus {
    border-top-color: #b8b8b8;
    border-right-color: #b8b8b8;
    border-bottom-color: #b8b8b8;
    border-left-color: #b8b8b8;
    background-color: rgba(0, 0, 0, 0);
}

.dependency-search-control Button {
    min-width: 18px;
    width: 18px;
    height: 20px;
    margin-right: 0;
    margin-top: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.dependency-search-control .dependency-search-arrow-button {
    min-width: 22px;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 3px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.dependency-search-control .dependency-search-arrow-button:enabled:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
    border-left-color: rgba(255, 255, 255, 0.35);
}

.dependency-search-control .dependency-search-arrow-button:enabled:active {
    background-color: rgba(255, 255, 255, 1);
    border-top-color: rgba(255, 255, 255, 1);
    border-right-color: rgba(255, 255, 255, 1);
    border-bottom-color: rgba(255, 255, 255, 1);
    border-left-color: rgba(255, 255, 255, 1);
}

#search-previous-button {
    margin-right: 6px;
}

.dependency-search-suggestion-list {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    max-height: 520px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #46515e;
    border-right-color: #303943;
    border-bottom-color: #242b33;
    border-left-color: #46515e;
    background-color: #1f242b;
    overflow: visible;
}

.dependency-search-suggestion-row {
    min-height: 38px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.dependency-search-suggestion-row:hover {
    background-color: #303943;
}

.dependency-search-suggestion-title {
    color: #eef2f7;
    font-size: 11px;
    white-space: normal;
    overflow: visible;
}

.dependency-search-suggestion-detail {
    color: #aeb8c4;
    font-size: 10px;
    white-space: normal;
    overflow: visible;
}

.dependency-search-count {
    width: 48px;
    height: 20px;
    margin-top: 2px;
    color: #d7dae0;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: visible;
}

.dependency-search-divider {
    width: 0.5px;
    height: 20px;
    margin-left: 5px;
    margin-right: 7px;
    margin-top: 2px;
    background-color: #b8b8b8;
}

.dependency-zoom-step-control {
    width: 196px;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    margin-right: 10px;
}

.dependency-zoom-scale-label {
    width: 78px;
    margin-right: 4px;
    color: #c7d0dc;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.dependency-zoom-step-control Slider {
    width: 108px;
}
